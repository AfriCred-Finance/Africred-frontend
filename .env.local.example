# Copy to .env.local and fill in after deploying the contracts.
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_ROUTER_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# Server-side only (NOT exposed to the browser): Pinata JWT for pinning dossier files to IPFS.
# Get a free one at https://app.pinata.cloud (API Keys -> New Key).
PINATA_JWT=

# ------------------------------------------------------------------- settlement
# The settlement service holds the owner and allocator keys, so the browser never
# reaches it directly: /api/settlement/* proxies there server-side.
SETTLEMENT_API_URL=http://127.0.0.1:8787

# Explorer used for settlement transaction links. Base mainnet by default.
NEXT_PUBLIC_EXPLORER_URL=https://basescan.org
